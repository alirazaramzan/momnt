# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser, RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key for transactional email (server only)
RESEND_API_KEY=
# Base URL of the site, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=
